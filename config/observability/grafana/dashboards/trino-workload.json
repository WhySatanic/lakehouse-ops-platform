        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "trino_execution_name_QueryManager_RunningQueries",
          "legendFormat": "running",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "trino_execution_name_QueryManager_QueuedQueries",
          "legendFormat": "queued",
          "range": true,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "trino_execution_name_QueryManager_WaitingForResourcesQueries",
          "legendFormat": "waiting for resources",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Active query pressure",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "qps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "rate(trino_execution_name_QueryManager_StartedQueries[5m])",
          "legendFormat": "started",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "rate(trino_execution_name_QueryManager_CompletedQueries[5m])",
          "legendFormat": "completed",
          "range": true,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "rate(trino_execution_name_QueryManager_FailedQueries[5m])",
          "legendFormat": "failed",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Query throughput (5m rate)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * rate(trino_execution_name_QueryManager_FailedQueries[5m]) / clamp_min(rate(trino_execution_name_QueryManager_StartedQueries[5m]), 0.000001)",
          "legendFormat": "failed queries",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Query failure percentage",
      "type": "stat"
    }
  ],
