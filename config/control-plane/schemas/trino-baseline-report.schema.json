{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WhySatanic/lakehouse-ops-platform/schemas/trino-baseline-report-1.0.json",
  "title": "Trino query baseline report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "collected_at", "engine", "mode", "corpus", "queries"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"const": "ready"},
    "collected_at": {"type": "string", "minLength": 1},
    "engine": {"const": "trino"},
    "mode": {"const": "explain_analyze"},
    "corpus": {"$ref": "#/$defs/corpus"},
    "queries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {"$ref": "#/$defs/query"}
    }
  },
  "$defs": {
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "name", "query_count"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "name": {"type": "string", "minLength": 1},
        "query_count": {"type": "integer", "minimum": 1, "maximum": 25}
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_id", "description", "trino_query_id", "sql_sha256", "plan_sha256", "plan_line_count", "metrics"],
      "properties": {
        "query_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "description": {"type": "string", "minLength": 1},
        "trino_query_id": {"type": "string", "minLength": 1},
        "sql_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "plan_line_count": {"type": "integer", "minimum": 1},
        "metrics": {"$ref": "#/$defs/metrics"}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "elapsed_time_ms", "wall_time_ms", "cpu_time_ms", "processed_rows", "processed_bytes", "physical_input_bytes", "peak_memory_bytes", "spilled_bytes"],
      "properties": {
        "state": {"const": "FINISHED"},
        "elapsed_time_ms": {"type": "integer", "minimum": 0},
        "wall_time_ms": {"type": "integer", "minimum": 0},
        "cpu_time_ms": {"type": "integer", "minimum": 0},
        "processed_rows": {"type": "integer", "minimum": 0},
        "processed_bytes": {"type": "integer", "minimum": 0},
        "physical_input_bytes": {"type": "integer", "minimum": 0},
        "peak_memory_bytes": {"type": "integer", "minimum": 0},
        "spilled_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
