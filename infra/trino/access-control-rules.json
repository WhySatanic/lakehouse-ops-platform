        "UPDATE",
        "OWNERSHIP",
        "GRANT_SELECT"
      ]
    },
    {
      "user": "lakehouse\\-operator|lakehouse\\-bi\\-inspector|lakehouse\\-ops|lakehouse\\-ci|lakehouse\\-performance|lakehouse\\-recovery\\-drill|lakehouse\\-ingestion\\-ci|lakehouse\\-bi\\-ci|lakehouse\\-analyst|metadata\\-cache\\-readiness|upgrade\\-readiness|upgrade\\-rehearsal",
      "catalog": "lakehouse|lakehouse_cache_disabled|system",
      "schema": ".*",
      "table": ".*",
      "privileges": [
        "SELECT"
      ]
    },
    {
      "user": "data_engineer",
      "catalog": "lakehouse|lakehouse_cache_disabled",
      "schema": "bronze|silver|gold",
      "table": ".*",
      "privileges": [
        "SELECT"
      ]
    },
    {
